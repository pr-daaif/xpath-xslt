# Copiez ce fichier en .env et adaptez les valeurs.

# Mot de passe pour supprimer les fichiers partagés (bouton « Admin » de l'interface)
ADMIN_PASSWORD=changez-moi

# Nombre de proxys devant l'application (1 = un nginx/Caddy). Sert à identifier l'IP réelle des étudiants.
TRUST_PROXY=1

# Nombre de processus d'évaluation en parallèle, et délai maximal par évaluation
POOL_SIZE=4
EVAL_TIMEOUT_MS=10000

# Taille maximale d'un fichier téléversé (Mo)
MAX_UPLOAD_MB=5
